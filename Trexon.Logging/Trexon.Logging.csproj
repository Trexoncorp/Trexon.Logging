<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Version>1.0.0-dev</Version>

    <PackageId>Trexon.Logging</PackageId>
    <Title>Trexon.Logging</Title>
    <Authors>Trexoncorp</Authors>
    <Description>Simple structured logging for .NET with fluent configuration, console and file output, contextual properties and redaction.</Description>
    <PackageTags>logging;logger;loguru;structured-logging</PackageTags>
    <PackageProjectUrl>https://github.com/Trexoncorp/Trexon.Logging</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Trexoncorp/Trexon.Logging</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../README.ru.md" Pack="true" PackagePath="/" />
    <None Include="../README.en.md" Pack="true" PackagePath="/" />
    <None Include="../README.de.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
